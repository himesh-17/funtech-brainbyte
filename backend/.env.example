# ===========================
# Server Configuration
# ===========================
PORT=5000
NODE_ENV=development

# ===========================
# MongoDB
# ===========================
# Local: mongodb://localhost:27017/quiz-app
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/quiz-app
MONGODB_URI=mongodb://localhost:27017/quiz-app

# Max connection pool size — tune based on expected concurrency.
# 50 is a good starting point for ~150 concurrent users.
MONGO_POOL_SIZE=50

# ===========================
# JWT (participant tokens)
# ===========================
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_hex_string
JWT_EXPIRES_IN=60m

# ===========================
# Admin Secret
# ===========================
# Passed as x-admin-secret header to access admin endpoints.
# Generate a strong random string, different from JWT_SECRET.
ADMIN_SECRET=CHANGE_ME_generate_a_different_random_string

# ===========================
# CORS
# ===========================
# Set to the origin of your frontend (e.g., http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# ===========================
# Quiz Settings
# ===========================
# Total time limit for the quiz in seconds (default: 1800 = 30 minutes)
QUIZ_TIME_LIMIT_SECONDS=1800

# Set to "true" to shuffle question order per participant
SHUFFLE_QUESTIONS=false
